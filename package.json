{
  "name": "freedeck",
  "version": "6.0.0-dev-rc7-01",
  "description": "The FOSS alternative to the Elgato Stream Deck, now supercharged with a new codebase. https://freedeck.app",
  "main": "src/app/companion/launcher.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freedeck/freedeck.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "webpack --config webpack.config.js && electron-builder --publish never",
    "publish": "webpack --config webpack.config.js && electron-builder --publish always",
    "server": "node src/index.js --is-dev=true",
    "test": "node src/self-test.js",
    "format": "prettier --loglevel warn --write \"**/*.{js,css,md}\""
  },
  "keywords": [
    "streamdeck",
    "stream deck",
    "elgato",
    "stream",
    "freedeck",
    "streaming",
    "alternative"
  ],
  "_moduleAliases": {
    "@root": "/",
    "@src": "src",
    "@routers": "src/routers",
    "@public": "src/public",
    "@managers": "src/managers",
    "@handlers": "src/handlers",
    "$": "src/utils",
    "@freedeck": "src/classes"
  },
  "author": "ia74",
  "license": "ISC",
  "dependencies": {
    "asar-bundle-runner": "^1.6.0",
    "babel-loader": "^10.1.1",
    "bonjour-service": "^1.4.4",
    "compare-versions": "^6.1.1",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "formidable": "^3.5.4",
    "module-alias": "^2.3.4",
    "pako": "^2.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tar": "^7.5.22",
    "webpack": "^5.109.2",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.6",
    "webpack-cli": "^7.2.2"
  },
  "lint-staged": {
    "*.{js,css,md,html}": "prettier --write"
  },
  "build": {
    "appId": "app.freedeck.companion",
    "productName": "Freedeck",
    "asar": false,
    "files": [
      "src/**/*",
      "!src/configs/**/*",
      "!plugins/**/*",
      "!user-data/**/*",
      "webui/**/*",
      "node_modules/**/*",
      "webpack/**",
      "package.json",
      "webpack.config.js",
      "timecache-analytics.js"
    ],
    "icon": "webui/client/assets/logo_big.ico",
    "win": {
      "publish": [
        "github"
      ],
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh"
    }
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6"
  }
}
