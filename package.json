{
  "name": "freedeck",
  "version": "6.0.0d-rc7",
  "description": "The FOSS alternative to the Elgato Stream Deck, now supercharged with a new codebase. https://freedeck.app",
  "main": "src/index.js",
  "scripts": {
    "start": "electron .",
    "companion": "electron . --companion-only",
    "server": "node src/index.js --server-only",
    "debug-server": "node src/index.js --server-only --debug",
    "test": "node src/self-test.js",
    "format": "prettier --loglevel warn --write \"**/*.{js,css,md}\""
  },
  "keywords": [
    "streamdeck",
    "stream deck",
    "elgato",
    "stream",
    "freedeck",
    "streaming",
    "alternative"
  ],
  "_moduleAliases": {
    "@root": "/",
    "@src": "src",
    "@routers": "src/routers",
    "@public": "src/public",
    "@managers": "src/managers",
    "@handlers": "src/handlers",
    "$": "src/utils",
    "@freedeck": "src/classes"
  },
  "author": "ia74",
  "license": "ISC",
  "dependencies": {
    "asar-bundle-runner": "^1.6.0",
    "babel-loader": "^10.1.1",
    "compare-versions": "^6.1.1",
    "electron": "^43.0.0",
    "express": "^5.2.1",
    "formidable": "^3.5.4",
    "module-alias": "^2.3.4",
    "pako": "^2.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tar": "^7.5.19",
    "webpack": "^5.108.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "prettier": "^3.9.4"
  },
  "lint-staged": {
    "*.{js,css,md,html}": "prettier --write"
  }
}
